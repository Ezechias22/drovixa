# Local backend execution (when running from backend/ instead of Docker Compose)
APP_NAME=Drovixa
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8081"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]

DATABASE_URL=postgresql+asyncpg://drovixa:drovixa_dev_password@localhost:5432/drovixa
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=drovixa-api
JWT_AUDIENCE=drovixa-clients
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=60

FIRST_SUPERUSER_EMAIL=owner@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password
FIRST_SUPERUSER_NAME=Drovixa Owner

RATE_LIMIT_ENABLED=true
HEALTHCHECK_REDIS_REQUIRED=true

# Video streaming (Mux is active; Cloudflare remains an optional adapter)
VIDEO_PROVIDER=mux
VIDEO_API_TIMEOUT_SECONDS=20
VIDEO_UPLOAD_MAX_BYTES=10737418240
VIDEO_UPLOAD_MAX_DURATION_SECONDS=14400
VIDEO_PLAYBACK_TOKEN_TTL_SECONDS=900
VIDEO_WEBHOOK_TOLERANCE_SECONDS=300
VIDEO_ALLOWED_ORIGINS=[]

# Mux Video — use credentials from the same Mux environment
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY_B64=
MUX_WEBHOOK_SECRET=
MUX_UPLOAD_CORS_ORIGIN=*
MUX_UPLOAD_TIMEOUT_SECONDS=21600
MUX_VIDEO_QUALITY=basic
MUX_MAX_RESOLUTION_TIER=1080p
MUX_API_BASE_URL=https://api.mux.com/video/v1

# Optional legacy provider
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM_B64=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# Playback policy
WATCH_COMPLETION_PERCENTAGE=90
PROGRESS_SYNC_INTERVAL_SECONDS=15
MINIMUM_VIEW_SECONDS=7
DEFAULT_SIMULTANEOUS_STREAM_LIMIT=1
PREMIUM_SIMULTANEOUS_STREAM_LIMIT=2
GEO_COUNTRY_HEADER=CF-IPCountry

# Phase 11 social login — comma-separated IDs or JSON arrays.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=

# Google AdMob rewarded ads. Create the rewarded units in your AdMob account.
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=
ADMOB_IOS_REWARDED_AD_UNIT_ID=
ADMOB_SSV_PUBLIC_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADMOB_SSV_KEY_CACHE_SECONDS=86400
ENGAGEMENT_AUTOMATION_ENABLED=true
