# Images created by the release workflow. Pin immutable version tags in production.
BACKEND_IMAGE=ghcr.io/OWNER/drovixa-backend:0.9.0
WEB_IMAGE=ghcr.io/OWNER/drovixa-web:0.9.0
ADMIN_IMAGE=ghcr.io/OWNER/drovixa-admin:0.9.0
RELEASE=drovixa@0.9.0

APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com
TLS_EMAIL=ops@example.com
WEB_CONCURRENCY=2
CELERY_CONCURRENCY=2

APP_NAME=Drovixa
APP_ENV=production
SERVICE_ROLE=api
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
TRUSTED_HOSTS=["api.example.com","backend","localhost","127.0.0.1"]
TRUST_PROXY_HEADERS=true
FORCE_HTTPS=true
MAX_REQUEST_BODY_BYTES=2097152

# Use managed PostgreSQL and Redis with TLS. Do not commit real credentials.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@DB_HOST:5432/drovixa?ssl=require
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379/0
CELERY_BROKER_URL=rediss://:PASSWORD@REDIS_HOST:6379/1
CELERY_RESULT_BACKEND=rediss://:PASSWORD@REDIS_HOST:6379/2
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=30000

JWT_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
REFRESH_SECRET=GENERATE_A_DIFFERENT_32_CHARACTER_SECRET
JWT_ALGORITHM=HS256
JWT_ISSUER=drovixa-api
JWT_AUDIENCE=drovixa-clients

FIRST_SUPERUSER_EMAIL=owner@example.com
FIRST_SUPERUSER_PASSWORD=USE_A_PASSWORD_MANAGER_VALUE
FIRST_SUPERUSER_NAME=Drovixa Owner

RATE_LIMIT_ENABLED=true
HEALTHCHECK_REDIS_REQUIRED=true
METRICS_ENABLED=true
METRICS_TOKEN=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_DSN=

VIDEO_PROVIDER=mux
VIDEO_ALLOWED_ORIGINS=["https://app.example.com"]
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY_B64=
MUX_WEBHOOK_SECRET=
MUX_UPLOAD_CORS_ORIGIN=https://admin.example.com

PAYMENT_PROVIDER=disabled
PAYMENT_SUCCESS_URL=https://app.example.com/payment/success
PAYMENT_CANCEL_URL=https://app.example.com/payment/cancelled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

IAP_VERIFICATION_ENABLED=false
APPLE_IAP_SHARED_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=com.drovixa.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_B64=

# Firebase Cloud Messaging. Store the service account as base64, never as a committed file.
PUSH_PROVIDER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
FIREBASE_DRY_RUN=false
PUSH_BATCH_SIZE=500
