# Runtime
APP_NAME=Drovixa
APP_ENV=development
SERVICE_ROLE=api
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
RELEASE=drovixa@0.9.0
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8081"]
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
TRUST_PROXY_HEADERS=false
FORCE_HTTPS=false
HSTS_MAX_AGE_SECONDS=31536000
MAX_REQUEST_BODY_BYTES=2097152
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_RELEASE=drovixa-web@0.9.0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Add the current Wi-Fi IP here only for phone testing, e.g. localhost,127.0.0.1,192.168.1.10
DEV_ALLOWED_ORIGINS=localhost,127.0.0.1
# Use true only when the Admin Dashboard is served over HTTPS.
ADMIN_COOKIE_SECURE=false

# Infrastructure
DATABASE_URL=postgresql+asyncpg://drovixa:drovixa_dev_password@postgres:5432/drovixa
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=30000
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_CONNECT_TIMEOUT_SECONDS=5

# Security — generate independent values with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=drovixa-api
JWT_AUDIENCE=drovixa-clients
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=60

# Bootstrap (used only by the explicit bootstrap command)
FIRST_SUPERUSER_EMAIL=owner@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password
FIRST_SUPERUSER_NAME=Drovixa Owner

# Operations
RATE_LIMIT_ENABLED=true
HEALTHCHECK_REDIS_REQUIRED=true
METRICS_ENABLED=true
# Required in staging/production when metrics are enabled; generate with openssl rand -hex 32.
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Video streaming (Drovixa active provider: Mux)
VIDEO_PROVIDER=mux
VIDEO_API_TIMEOUT_SECONDS=20
VIDEO_UPLOAD_MAX_BYTES=10737418240
VIDEO_UPLOAD_MAX_DURATION_SECONDS=14400
VIDEO_PLAYBACK_TOKEN_TTL_SECONDS=900
VIDEO_WEBHOOK_TOLERANCE_SECONDS=300
VIDEO_ALLOWED_ORIGINS=[]

# Mux Video — use credentials from the same Mux environment
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY_B64=
MUX_WEBHOOK_SECRET=
MUX_UPLOAD_CORS_ORIGIN=*
MUX_UPLOAD_TIMEOUT_SECONDS=21600
MUX_VIDEO_QUALITY=basic
MUX_MAX_RESOLUTION_TIER=1080p
MUX_API_BASE_URL=https://api.mux.com/video/v1

# Playback policy
WATCH_COMPLETION_PERCENTAGE=90
PROGRESS_SYNC_INTERVAL_SECONDS=15
MINIMUM_VIEW_SECONDS=7
DEFAULT_SIMULTANEOUS_STREAM_LIMIT=1
PREMIUM_SIMULTANEOUS_STREAM_LIMIT=2
GEO_COUNTRY_HEADER=CF-IPCountry

# Payments — keep disabled until real provider credentials and webhooks are configured
PAYMENT_PROVIDER=disabled
PAYMENT_API_TIMEOUT_SECONDS=20
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancelled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com/v1

# Mobile store receipt verification — never grant purchases from frontend events alone
IAP_VERIFICATION_ENABLED=false
APPLE_IAP_SHARED_SECRET=
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_B64=

# Push notifications — in-app notifications continue to work while disabled.
# Base64-encode the complete Firebase service-account JSON; never commit the JSON file.
PUSH_PROVIDER=disabled
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_B64=
FIREBASE_DRY_RUN=false
PUSH_BATCH_SIZE=500
# queue = Celery worker (production); inline = API request (small/free staging deployments)
NOTIFICATION_DELIVERY_MODE=queue
# Enable only on a single API instance when no Celery Beat scheduler is available.
SCHEDULED_NOTIFICATION_POLLING_ENABLED=false
SCHEDULED_NOTIFICATION_POLL_INTERVAL_SECONDS=60
